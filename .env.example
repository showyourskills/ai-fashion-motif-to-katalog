# Google Cloud Configuration
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# API Keys
VERTEX_AI_REGION=us-central1
GOOGLE_VISION_API_KEY=your-vision-api-key
GOOGLE_GENERATIVE_AI_API_KEY=your-generative-ai-key

# Database
MONGODB_URI=mongodb://localhost:27017/fashion-ai
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=password123

# Backend (Node.js + Express)
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-key-here

# Frontend (React)
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000
VITE_AI_SERVICE_URL=http://localhost:8000

# AI Pipeline (FastAPI)
AI_PIPELINE_PORT=8000
AI_PIPELINE_URL=http://localhost:8000
PYTHON_ENV=development

# Model Configuration
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
CONTROLNET_MODEL=lllyasviel/sd-controlnet-canny
MODEL_CACHE_DIR=./models
CUDA_VISIBLE_DEVICES=0

# Generation Parameters
INFERENCE_STEPS=30
GUIDANCE_SCALE=7.5
DENOISE_STEPS=30
OUTPUT_RESOLUTION=512

# Feature Flags
ENABLE_GOOGLE_CLOUD_VISION=true
ENABLE_VERTEX_AI=true
ENABLE_CONTROLNET=true
ENABLE_LORA_TRAINING=false

# Logging
LOG_LEVEL=INFO
DEBUG_MODE=false
